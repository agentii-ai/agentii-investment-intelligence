{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentii.ai/contracts/workflow.schema.json",
  "title": "Enhancement Workflow Preset",
  "description": "Schema for workflows/*.yaml enrichment presets (spec 039 Part I, contracts/workflow.schema.md, FR-001..FR-007).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "version", "stages"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "unique within workflows/; user preset overrides bundled same-name"
    },
    "description": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "semver MAJOR.MINOR.PATCH"
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vertical": { "type": "string", "minLength": 1 },
        "layer_tags": {
          "type": "array",
          "items": { "type": "string", "enum": ["L1", "L2", "L3", "L4"] }
        },
        "min_quality_score": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/stage" }
    }
  },
  "definitions": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "prompt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["reference_injection", "methodology_patch", "quality_audit", "custom"]
        },
        "prompt": { "type": "string", "minLength": 1 },
        "uses_history": { "type": "boolean", "default": false }
      }
    }
  }
}
