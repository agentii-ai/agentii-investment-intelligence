# agentii-investment-intelligence — environment variables
#
# Copy this file to .env.local and fill in your real values. .env.local is
# gitignored. Get an API key at https://agentii.ai (7-day free trial, 2,000
# credits, no credit card).
#
# Used by:
#   - tools/src/env.ts            (MCP server distribution path)
#   - scripts/smoke-test.sh       (Live API smoke test)
#   - tests/integration/*.spec.ts (Live integration tests; not in CI by default)

# Required: API key issued by agentii.ai billing portal
AGENTII_API_KEY="sk_live_REPLACE_WITH_YOUR_KEY"

# Optional: override the MCP / API base URL (defaults to https://mcp.agentii.ai)
# AGENTII_MCP_URL="https://mcp.agentii.ai/mcp"
# AGENTII_API_URL="https://mcp.agentii.ai"
